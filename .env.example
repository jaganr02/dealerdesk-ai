# DealerDesk Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# The automated grader deletes any committed .env and provides these variables via the environment.

# Django Core
SECRET_KEY=change-to-a-secure-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# PostgreSQL Database Configuration (SQLite is strictly prohibited)
# API contract required connection URL format: postgres://user:password@host:5432/dbname
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/dealerdesk

# Supplier API Integration (Optional for AI/ML track)
SUPPLIER_API_URL=http://localhost:8001
SUPPLIER_API_KEY=your_supplier_api_key_here

# LLM Provider Key (Required for AI/ML track Dealer Assistant)
# Supported keys: GEMINI_API_KEY, GROQ_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY
GEMINI_API_KEY=your_gemini_api_key_here
